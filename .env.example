# Copy to .env.local for local work. In production set these as Cloudflare Worker
# variables/secrets (wrangler secret put NAME). Never commit real values.

# ── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://haroonsukhera.com

# ── Cloudflare Turnstile (contact form + booking) ───────────────────────
# Dashboard → Turnstile → Add site (haroonsukhera.com, localhost)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Contact form delivery ───────────────────────────────────────────────
# Where messages are sent.
CONTACT_TO_EMAIL=haroonsukheraofficial@gmail.com
# Resend (free plan) — https://resend.com → API keys. FROM must be on a domain verified in Resend.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Haroon Sukhera website <hello@haroonsukhera.com>"
# Optional: also POST every submission to a webhook (n8n, CRM).
CONTACT_WEBHOOK_URL=

# ── Booking: Google Calendar (see reference/webix/docs/BOOKING-SETUP.md) ─
# Without these three, the booking block shows WhatsApp/email instead — never fake slots.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ── Analytics (load only after cookie consent) ──────────────────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=
